{
  "query": "\n-- 檢查 soldAt 和 createdAt 的差異\nSELECT \n  ph.cardId,\n  ph.price,\n  ph.grade,\n  ph.soldAt,\n  ph.createdAt,\n  CASE \n    WHEN ph.soldAt IS NULL THEN 'NULL'\n    ELSE 'HAS VALUE'\n  END as soldAt_status,\n  DATEDIFF(NOW(), COALESCE(ph.soldAt, ph.createdAt)) as daysAgo\nFROM priceHistory ph\nJOIN cards c ON ph.cardId = c.id\nWHERE c.name LIKE '%Japanese National Team%'\n  AND ph.grade = 'PSA10'\nORDER BY COALESCE(ph.soldAt, ph.createdAt) ASC\nLIMIT 10;\n",
