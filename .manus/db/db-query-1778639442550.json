  "query": "\nSELECT \n  p1.id, p2.id as id2,\n  p1.cardId, p1.jpyPrice, p1.grade, p1.sourcePosition,\n  p1.soldAt as soldAt1, p2.soldAt as soldAt2,\n  ABS(TIMESTAMPDIFF(HOUR, p1.soldAt, p2.soldAt)) as hour_diff\nFROM priceHistory p1\nJOIN priceHistory p2 ON (\n  p1.id < p2.id\n  AND p1.cardId = p2.cardId\n  AND p1.source = 'snkrdunk'\n  AND p2.source = 'snkrdunk'\n  AND p1.jpyPrice = p2.jpyPrice\n  AND COALESCE(p1.grade, '') = COALESCE(p2.grade, '')\n  AND p1.sourcePosition = p2.sourcePosition\n  AND ABS(TIMESTAMPDIFF(HOUR, p1.soldAt, p2.soldAt)) <= 72\n)\nLIMIT 10;\n",
