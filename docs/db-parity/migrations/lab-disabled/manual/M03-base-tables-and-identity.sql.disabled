  "hasReserveMet" boolean DEFAULT FALSE NOT NULL,
  "winnerId" integer,
  "winningBidId" integer,
  "auctionTermsVersion" varchar(20),
  "isHighValueReview" boolean DEFAULT FALSE NOT NULL,
  "auctionPaymentSessionId" varchar(200),
  "auctionPaymentStatus" "enum_marketplace_listings_auction_payment_status",
  "auctionPaymentPaidAt" timestamp with time zone,
  "auctionOrderId" integer,
  "viewCount" integer DEFAULT 0 NOT NULL,
  "listedAt" timestamp with time zone,
  "createdAt" timestamp with time zone DEFAULT CURRENT_TIMESTAMP NOT NULL,
  "updatedAt" timestamp with time zone DEFAULT CURRENT_TIMESTAMP NOT NULL
);

