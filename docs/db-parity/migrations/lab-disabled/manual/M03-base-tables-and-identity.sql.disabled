CREATE TABLE "games" (
  "id" integer GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  "code" varchar(32) NOT NULL UNIQUE,
  "name" varchar(128) NOT NULL,
  "nameJa" varchar(128),
  "nameZh" varchar(128),
  "publisher" varchar(128),
  "isActive" boolean DEFAULT TRUE NOT NULL,
  "sortOrder" integer DEFAULT 0 NOT NULL,
  "icon" text,
  "createdAt" timestamp with time zone DEFAULT CURRENT_TIMESTAMP NOT NULL,
  "updatedAt" timestamp with time zone DEFAULT CURRENT_TIMESTAMP NOT NULL
);

CREATE TABLE "fxRates" (
  "id" integer GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  "baseCurrency" varchar(3) NOT NULL,
  "quoteCurrency" varchar(3) NOT NULL,
  "rate" numeric(18, 8) NOT NULL,
  "rateDate" varchar(10) NOT NULL,
  "provider" varchar(64) DEFAULT 'frankfurter' NOT NULL,
  "fetchedAt" timestamp with time zone DEFAULT CURRENT_TIMESTAMP NOT NULL
);

CREATE TABLE "sealedProducts" (
  "id" integer GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  "gameId" integer NOT NULL,
  "name" text NOT NULL,
  "nameJa" text,
  "nameZh" text,
  "boxType" "enum_sealed_products_box_type" DEFAULT 'booster_box' NOT NULL,
  "itemCount" integer,
  "setName" text,
  "series" text,
  "imageUrl" text,
  "releaseDate" timestamp with time zone,
  "styleCode" text,
  "createdAt" timestamp with time zone DEFAULT CURRENT_TIMESTAMP NOT NULL,
  "updatedAt" timestamp with time zone DEFAULT CURRENT_TIMESTAMP NOT NULL
);

CREATE TABLE "users" (
  "id" integer GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  "email" varchar(320) NOT NULL UNIQUE,
  "name" text,
  "passwordHash" varchar(255),
  "googleId" varchar(128),
  "appleId" varchar(128),
  "loginMethod" "enum_users_login_method" NOT NULL,
  "role" "enum_users_role" DEFAULT 'user' NOT NULL,
  "emailVerified" boolean DEFAULT FALSE NOT NULL,
  "createdAt" timestamp with time zone DEFAULT CURRENT_TIMESTAMP NOT NULL,
  "updatedAt" timestamp with time zone DEFAULT CURRENT_TIMESTAMP NOT NULL,
  "lastSignedIn" timestamp with time zone DEFAULT CURRENT_TIMESTAMP NOT NULL,
  "phone" varchar(30),
  "phoneVerified" boolean DEFAULT FALSE NOT NULL,
  "phoneVerifyToken" varchar(128),
  "phoneVerifyExpires" bigint,
  "isBlocked" boolean DEFAULT FALSE NOT NULL,
  "blockReason" text,
  "emailVerificationToken" varchar(128),
  "emailVerificationExpiry" timestamp with time zone,
  "vipPlan" "enum_users_vip_plan" DEFAULT 'none' NOT NULL,
  "vipExpiresAt" timestamp with time zone,
  "stripeCustomerId" varchar(128),
  "stripeSubscriptionId" varchar(128),
  "vaultShareImageUrl" text
);

CREATE TABLE "cards" (
  "id" integer GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  "cardId" varchar(128) NOT NULL UNIQUE,
  "snkrdunkId" varchar(32) UNIQUE,
  "gameId" integer DEFAULT 1 NOT NULL,
  "name" text NOT NULL,
  "nameJa" text,
  "series" text,
  "setName" text,
  "cardNumber" varchar(32),
  "rarity" varchar(64),
  "language" varchar(16) DEFAULT 'en',
  "releaseDate" timestamp with time zone,
  "imageUrl" text,
  "imageUrlHiRes" text,
  "artist" text,
  "description" text,
  "types" text,
  "hp" integer,
  "psaSpecId" varchar(32),
  "psaMatchedAt" timestamp with time zone,
  "createdAt" timestamp with time zone DEFAULT CURRENT_TIMESTAMP NOT NULL,
  "updatedAt" timestamp with time zone DEFAULT CURRENT_TIMESTAMP NOT NULL
);

CREATE TABLE "priceHistory" (
  "id" integer GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  "cardId" integer NOT NULL,
  "productType" "enum_price_history_product_type" DEFAULT 'single_card' NOT NULL,
  "source" "enum_price_history_source" NOT NULL,
  "price" numeric(10, 2) NOT NULL,
  "currency" varchar(8) DEFAULT 'HKD' NOT NULL,
  "grade" varchar(32),
  "condition" varchar(64),
  "quantity" varchar(50),
  "jpyPrice" integer,
  "sourcePosition" integer DEFAULT 0 NOT NULL,
  "listingUrl" text,
  "soldAt" timestamp with time zone,
  "isSuspectedBulk" boolean DEFAULT FALSE NOT NULL,
  "recordHash" varchar(64),
  "title" varchar(512),
  "createdAt" timestamp with time zone DEFAULT CURRENT_TIMESTAMP NOT NULL
);

CREATE TABLE "watchlist" (
  "id" integer GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  "userId" integer NOT NULL,
  "cardId" integer NOT NULL,
  "productType" "enum_watchlist_product_type" DEFAULT 'single_card' NOT NULL,
  "targetPrice" numeric(10, 2),
  "currency" varchar(8) DEFAULT 'HKD',
  "notes" text,
  "createdAt" timestamp with time zone DEFAULT CURRENT_TIMESTAMP NOT NULL
);

CREATE TABLE "viewHistory" (
  "id" integer GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  "userId" integer NOT NULL,
  "cardId" integer NOT NULL,
  "productType" "enum_view_history_product_type" DEFAULT 'single_card' NOT NULL,
