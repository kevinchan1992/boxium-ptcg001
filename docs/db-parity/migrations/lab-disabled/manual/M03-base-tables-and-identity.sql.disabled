CREATE TABLE "marketplaceBanners" (
  "id" integer GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  "title" varchar(200) NOT NULL,
  "subtitle" varchar(300) DEFAULT '' NOT NULL,
  "cta" varchar(100) DEFAULT '立即選購' NOT NULL,
  "ctaConditions" varchar(500) DEFAULT '[]' NOT NULL,
  "ctaSellerType" varchar(20) DEFAULT 'all' NOT NULL,
  "gradient" varchar(200) DEFAULT 'from-[#06038d] via-[#1a0a9e] to-[#2d1bb5]' NOT NULL,
  "accentColor" varchar(20) DEFAULT '#FFD700' NOT NULL,
  "badge" varchar(50) DEFAULT '' NOT NULL,
  "badgeClass" varchar(100) DEFAULT 'bg-yellow-400 text-[#06038d]' NOT NULL,
  "emoji" varchar(10) DEFAULT '🏆' NOT NULL,
  "imageUrl" varchar(500) DEFAULT '' NOT NULL,
  "sortOrder" integer DEFAULT 0 NOT NULL,
  "isActive" boolean DEFAULT TRUE NOT NULL,
  "createdAt" timestamp with time zone DEFAULT CURRENT_TIMESTAMP NOT NULL,
  "updatedAt" timestamp with time zone DEFAULT CURRENT_TIMESTAMP NOT NULL
);

