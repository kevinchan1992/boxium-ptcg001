  "id" integer GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  "eventId" varchar(128) NOT NULL UNIQUE,
  "eventType" varchar(128) NOT NULL,
  "status" varchar(32) DEFAULT 'pending' NOT NULL,
  "rawPayload" text,
  "errorLog" text,
  "retryCount" integer DEFAULT 0 NOT NULL,
  "processedAt" timestamp with time zone,
  "createdAt" timestamp with time zone DEFAULT CURRENT_TIMESTAMP NOT NULL,
  "updatedAt" timestamp with time zone DEFAULT CURRENT_TIMESTAMP NOT NULL
);

CREATE TABLE "tcgMarketPrices" (
  "id" integer GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  "cardId" integer NOT NULL,
  "tcgCardId" varchar(64) NOT NULL,
  "tcgLow" numeric(10, 2),
  "tcgMid" numeric(10, 2),
  "tcgHigh" numeric(10, 2),
  "tcgMarket" numeric(10, 2),
  "cmAvg" numeric(10, 2),
  "cmTrend" numeric(10, 2),
  "cmAvg7" numeric(10, 2),
  "cmAvg30" numeric(10, 2),
  "updatedAt" timestamp with time zone DEFAULT CURRENT_TIMESTAMP NOT NULL,
  "createdAt" timestamp with time zone DEFAULT CURRENT_TIMESTAMP NOT NULL
);

CREATE TABLE "pools" (
  "id" integer GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  "title" varchar(255) NOT NULL,
  "description" text,
  "coverImageUrl" text,
  "totalSlots" integer DEFAULT 100 NOT NULL,
  "pricePoints" integer DEFAULT 1000 NOT NULL,
  "officialBuybackPoints" integer DEFAULT 300 NOT NULL,
  "visibleCardCost" integer DEFAULT 300 NOT NULL,
  "miscCost" integer DEFAULT 0 NOT NULL,
  "status" "enum_pools_pool_status" DEFAULT 'draft' NOT NULL,
  "maintenanceMode" boolean DEFAULT FALSE NOT NULL,
  "maintenanceMessage" varchar(500),
  "sortOrder" integer DEFAULT 0 NOT NULL,
  "publishedAt" timestamp with time zone,
  "tags" text,
  "returnRate" integer,
  "freeTrialEnabled" boolean DEFAULT FALSE NOT NULL,
  "createdAt" timestamp with time zone DEFAULT CURRENT_TIMESTAMP NOT NULL,
  "updatedAt" timestamp with time zone DEFAULT CURRENT_TIMESTAMP NOT NULL
);

CREATE TABLE "poolRewards" (
  "id" integer GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  "poolId" integer NOT NULL,
  "name" varchar(255) NOT NULL,
  "rewardType" "enum_pool_rewards_pr_reward_type" DEFAULT 'hidden' NOT NULL,
  "effectTier" varchar(50),
  "cost" integer DEFAULT 0 NOT NULL,
  "quantity" integer DEFAULT 1 NOT NULL,
  "triggerAt" integer,
  "imageUrl" text,
  "cardId" integer,
  "createdAt" timestamp with time zone DEFAULT CURRENT_TIMESTAMP NOT NULL
);

CREATE TABLE "poolSlots" (
  "id" integer GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  "poolId" integer NOT NULL,
  "slotIndex" integer NOT NULL,
  "rewardId" integer,
  "visibleCardName" varchar(255),
  "isDrawn" boolean DEFAULT FALSE NOT NULL,
  "drawnByUserId" integer,
  "drawnAt" timestamp with time zone,
  "createdAt" timestamp with time zone DEFAULT CURRENT_TIMESTAMP NOT NULL
);

CREATE TABLE "userVault" (
  "id" integer GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  "userId" integer NOT NULL,
  "poolSlotId" integer NOT NULL,
  "poolId" integer NOT NULL,
  "rewardId" integer DEFAULT 0 NOT NULL,
  "slotIndex" integer DEFAULT 0 NOT NULL,
  "poolTitle" varchar(255),
  "cardName" varchar(255),
  "cardImageUrl" text,
  "effectTier" integer DEFAULT 3 NOT NULL,
  "isMilestone" smallint DEFAULT 0 NOT NULL,
  "milestoneCardName" varchar(255),
  "milestoneCardImageUrl" text,
  "status" "enum_user_vault_uv_status" DEFAULT 'in_vault' NOT NULL,
  "buybackPoints" integer,
  "shippingAddressId" integer,
  "shippingTrackingNumber" varchar(128),
  "createdAt" timestamp with time zone DEFAULT CURRENT_TIMESTAMP NOT NULL
);

CREATE TABLE "userPointBalance" (
  "id" integer GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  "userId" integer NOT NULL UNIQUE,
  "balance" bigint DEFAULT 0 NOT NULL,
  "updatedAt" timestamp with time zone DEFAULT CURRENT_TIMESTAMP NOT NULL
);

CREATE TABLE "pointTransactions" (
  "id" integer GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  "userId" integer NOT NULL,
  "type" "enum_point_transactions_pt_type" NOT NULL,
  "amount" integer NOT NULL,
  "balanceAfter" bigint NOT NULL,
  "note" varchar(500),
  "referenceId" varchar(100),
  "createdAt" timestamp with time zone DEFAULT CURRENT_TIMESTAMP NOT NULL
);

CREATE TABLE "freeTrialDraws" (
  "id" integer GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  "userId" integer NOT NULL,
  "poolId" integer NOT NULL,
  "slotIndex" integer NOT NULL,
  "rewardId" integer,
  "rewardName" varchar(255),
  "rewardImageUrl" text,
  "createdAt" timestamp with time zone DEFAULT CURRENT_TIMESTAMP NOT NULL
);

CREATE TABLE "aiScanUsage" (
  "id" integer GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  "userId" integer NOT NULL,
  "yearMonth" varchar(7) NOT NULL,
  "count" integer DEFAULT 0 NOT NULL,
  "updatedAt" timestamp with time zone DEFAULT CURRENT_TIMESTAMP NOT NULL
);

CREATE TABLE "wallEntries" (
  "id" integer GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  "userId" integer NOT NULL UNIQUE,
  "displayName" varchar(128) NOT NULL,
  "avatarUrl" text,
  "totalValue" bigint DEFAULT 0 NOT NULL,
  "topCardId" integer,
  "topCardName" varchar(255),
  "topCardImageUrl" text,
  "topCardGrade" varchar(32),
  "topCardGrader" varchar(32),
  "topCardValue" bigint DEFAULT 0,
  "card2Name" varchar(255),
  "card2ImageUrl" text,
  "card2Grade" varchar(32),
  "card2Grader" varchar(32),
  "card2Value" bigint DEFAULT 0,
  "card3Name" varchar(255),
  "card3ImageUrl" text,
  "card3Grade" varchar(32),
  "card3Grader" varchar(32),
  "card3Value" bigint DEFAULT 0,
  "card4Name" varchar(255),
  "card4ImageUrl" text,
  "card4Grade" varchar(32),
  "card4Grader" varchar(32),
  "card4Value" bigint DEFAULT 0,
  "card5Name" varchar(255),
  "card5ImageUrl" text,
  "card5Grade" varchar(32),
  "card5Grader" varchar(32),
  "card5Value" bigint DEFAULT 0,
  "sighs" integer DEFAULT 0 NOT NULL,
  "posterUrl" text,
  "isPublic" boolean DEFAULT TRUE NOT NULL,
  "createdAt" timestamp with time zone DEFAULT CURRENT_TIMESTAMP NOT NULL,
  "updatedAt" timestamp with time zone DEFAULT CURRENT_TIMESTAMP NOT NULL
);

CREATE TABLE "wallComments" (
  "id" integer GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  "entryId" integer NOT NULL,
  "userId" integer NOT NULL,
  "displayName" varchar(128) NOT NULL,
  "content" varchar(500) NOT NULL,
  "createdAt" timestamp with time zone DEFAULT CURRENT_TIMESTAMP NOT NULL
);

CREATE TABLE "wallSighLogs" (
  "id" integer GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  "entryId" integer NOT NULL,
  "userId" integer NOT NULL,
  "createdAt" timestamp with time zone DEFAULT CURRENT_TIMESTAMP NOT NULL
);
